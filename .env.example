# Settings: prefix OWL_, nested delimiter __ (see specs/CONTRACT.md §10).

# Models, per role (extraction, polishing, judge). A role that is not configured at all uses
# "default" as a whole; a configured role must be complete (no key-by-key fallback).
OWL_MODELS__DEFAULT__PROVIDER=openai_compatible
OWL_MODELS__DEFAULT__NAME=local-model
OWL_MODELS__DEFAULT__BASE_URL=http://localhost:1234/v1
OWL_MODELS__DEFAULT__API_KEY=lm-studio
OWL_MODELS__DEFAULT__CONTEXT_WINDOW=32768
OWL_MODELS__DEFAULT__TEMPERATURE=0
# OWL_MODELS__DEFAULT__MAX_TOKENS=4096
# OWL_MODELS__DEFAULT__TIMEOUT=120
# OWL_MODELS__DEFAULT__MAX_RETRIES=2
# OWL_MODELS__DEFAULT__OUTPUT_MODE=native          # native | tool | prompted
# OWL_MODELS__DEFAULT__TPM_LIMIT=                  # unset = no pacing (CONTRACT §9.5)
# OWL_MODELS__DEFAULT__RATE_LIMIT_MAX_WAIT=600     # seconds of 429 waiting per call

# Azure OpenAI (databricks profile), e.g. for the extraction role:
# OWL_MODELS__EXTRACTION__PROVIDER=azure_openai
# OWL_MODELS__EXTRACTION__DEPLOYMENT=...
# OWL_MODELS__EXTRACTION__AZURE_ENDPOINT=https://<resource>.openai.azure.com
# OWL_MODELS__EXTRACTION__API_VERSION=...
# OWL_MODELS__EXTRACTION__API_KEY=...
# OWL_MODELS__EXTRACTION__CONTEXT_WINDOW=128000

# Context selection: fraction of CONTEXT_WINDOW available for document text.
# OWL_CONTEXT__BUDGET_FRACTION=0.6

# Value parsing (CONTRACT §4)
# OWL_PARSING__DATE_ORDER=day_first                # day_first | month_first
# OWL_PARSING__DECIMAL_PLACES=6
# OWL_PARSING__ENUM_SIMILARITY_THRESHOLD=0.92
# OWL_PARSING__ENUM_SIMILARITY_MARGIN=0.03

# Quote matcher (CONTRACT §8.2)
# OWL_MATCHER__FUZZY_MIN_LENGTH=25
# OWL_MATCHER__FUZZY_THRESHOLD=92
