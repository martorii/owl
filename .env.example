# Model settings, per role (see specs/CONTRACT.md §10). Unset roles fall back to "default".
OWL_MODELS__DEFAULT__PROVIDER=openai_compatible
OWL_MODELS__DEFAULT__NAME=local-model
OWL_MODELS__DEFAULT__BASE_URL=http://localhost:1234/v1
OWL_MODELS__DEFAULT__API_KEY=lm-studio
OWL_MODELS__DEFAULT__CONTEXT_WINDOW=32768
OWL_MODELS__DEFAULT__TEMPERATURE=0

# Observability (no endpoint = no-op)
# OWL_OTEL__ENDPOINT=http://localhost:4317
OWL_OTEL__CAPTURE_CONTENT=false
